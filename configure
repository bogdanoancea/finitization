#!/bin/sh
set -e

# --- Basics ---------------------------------------------------------------
PKG_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
UNAME_S=$(uname -s)
UNAME_M=$(uname -m)

case "$UNAME_S" in
  Darwin) OS=macos ;;
  Linux)  OS=linux ;;
  *)      OS=other ;;
esac

# Block webR / WASM (Emscripten)
if ${CC:-cc} --version 2>/dev/null | grep -qi emscripten; then
  echo "ERROR: webR/WASM is not supported by 'finitization'." >&2
  exit 1
fi

# --- Detect CRAN / check-like environments --------------------------------
# Goal: NEVER download during checks, and fail cleanly if system deps are missing.
CHECK_ENV=0

# R CMD check commonly sets this
if [ -n "${_R_CHECK_PACKAGE_NAME_:-}" ]; then
  CHECK_ENV=1
fi

# CRAN incoming sometimes sets this
if [ "${_R_CHECK_CRAN_INCOMING_:-}" = "TRUE" ]; then
  CHECK_ENV=1
fi

# Many check installs happen under a *.Rcheck directory (reliable heuristic)
case "$(pwd)" in
  *".Rcheck"*) CHECK_ENV=1 ;;
esac

# Allow manual override (useful for local debugging)
if [ "${CRAN_BUILD:-}" = "true" ]; then
  CHECK_ENV=1
fi

# Download of prebuilt static bundles is NEVER automatic.
# User must explicitly opt in (non-CRAN convenience only).
ALLOW_DOWNLOAD="${FINITIZATION_ALLOW_DOWNLOAD:-0}"

echo "configure: OS=$OS ARCH=$UNAME_M CHECK_ENV=$CHECK_ENV"

PKG_CONFIG="${PKG_CONFIG:-pkg-config}"

# Base flags (no -O here; let R handle optimization)
PKG_CFLAGS="-DNDEBUG"
PKG_CXXFLAGS="-DNDEBUG"
PKG_CPPFLAGS="-DNDEBUG"
PKG_LIBS=""

# --- Require pkg-config ----------------------------------------------------
if ! command -v "$PKG_CONFIG" >/dev/null 2>&1; then
  cat >&2 <<'EOM'
ERROR: 'pkg-config' was not found.
This package requires system development libraries for GMP, CLN, and GiNaC,
discoverable via pkg-config.

Install:
  - Debian/Ubuntu: sudo apt-get install -y pkg-config libgmp-dev libcln-dev libginac-dev
  - Fedora:        sudo dnf install      pkgconf-pkg-config gmp-devel cln-devel ginac-devel
  - openSUSE:      sudo zypper install   pkgconf-pkg-config gmp-devel cln-devel ginac-devel
  - macOS:         brew install pkg-config gmp cln ginac
EOM
  exit 1
fi

# --- Preferred: system libs via pkg-config --------------------------------
if "$PKG_CONFIG" --exists gmp cln ginac; then
  echo "configure: Found GMP/CLN/GiNaC via pkg-config."
  PKG_CPPFLAGS=$("$PKG_CONFIG" --cflags ginac cln gmp)
  PKG_LIBS=$("$PKG_CONFIG" --libs ginac cln gmp)
else
  # --- Policy when system libs not found ----------------------------------
  # In CHECK_ENV (CRAN/check), we must NOT download; fail with an informative message.
  if [ "$CHECK_ENV" -eq 1 ]; then
    cat >&2 <<'EOM'
ERROR: System libraries for GiNaC/CLN/GMP were not found via pkg-config.
This package requires system installations of GiNaC, CLN and GMP.

Please install the development packages and ensure pkg-config can find them:

  - Debian/Ubuntu:
      sudo apt-get install -y pkg-config libgmp-dev libcln-dev libginac-dev
  - Fedora:
      sudo dnf install pkgconf-pkg-config gmp-devel cln-devel ginac-devel
  - openSUSE:
      sudo zypper install pkgconf-pkg-config gmp-devel cln-devel ginac-devel
  - macOS (Homebrew):
      brew install pkg-config gmp cln ginac

EOM
    exit 1
  fi

  # Outside checks: do not download unless user explicitly opts in
  if [ "$ALLOW_DOWNLOAD" != "1" ]; then
    cat >&2 <<'EOM'
ERROR: System libraries for GiNaC/CLN/GMP were not found via pkg-config.

Automatic downloading of bundled static libraries is disabled by default.
To enable the (non-CRAN) convenience download, re-run with:

  FINITIZATION_ALLOW_DOWNLOAD=1 R CMD INSTALL ...

Alternatively, install system libraries and retry:
  - Debian/Ubuntu: sudo apt-get install -y libginac-dev libcln-dev libgmp-dev pkg-config
  - macOS:         brew install ginac cln gmp pkg-config
EOM
    exit 1
  fi

  # --- Optional non-CRAN fallback: download prebuilt static bundles --------
  case "$OS:$UNAME_M" in
    linux:x86_64)
      BURL="https://github.com/bogdanoancea/finitization-linuxlibs/releases/download/v1.0.0/finitization-x86_64-gmp+cln+ginac-static.zip"
      BDIR="$PKG_ROOT/extlibs/linux/x86_64"
      ;;
    linux:aarch64|linux:arm64)
      BURL="https://github.com/bogdanoancea/finitization-linuxlibs/releases/download/v1.0.0/finitization-aarch64-gmp+cln+ginac-static.zip"
      BDIR="$PKG_ROOT/extlibs/linux/aarch64"
      ;;
    macos:x86_64)
      BURL="https://github.com/bogdanoancea/finitization-macoslibs/releases/download/v1.0.0/finitization-x86_64-gmp+cln+ginac-static.zip"
      BDIR="$PKG_ROOT/extlibs/macos/x86_64"
      PKG_CXXFLAGS="${PKG_CXXFLAGS} -mmacosx-version-min=12.0"
      PKG_CFLAGS="${PKG_CFLAGS} -mmacosx-version-min=12.0"
      PKG_LIBS="${PKG_LIBS} -mmacosx-version-min=12.0"
      ;;
    macos:arm64)
      BURL="https://github.com/bogdanoancea/finitization-macoslibs/releases/download/v1.0.0/finitization-arm64-gmp+cln+ginac-static.zip"
      BDIR="$PKG_ROOT/extlibs/macos/arm64"
      ;;
    *)
      echo "ERROR: No prebuilt bundle available for $OS/$UNAME_M." >&2
      exit 1
      ;;
  esac

  mkdir -p "$PKG_ROOT/extlibs" "$BDIR"
  ZIP="$PKG_ROOT/extlibs/$(basename "$BURL")"
  echo "configure: Falling back to static bundles (FINITIZATION_ALLOW_DOWNLOAD=1): $BURL"

  if command -v curl >/dev/null 2>&1; then
    curl -L -o "$ZIP" "$BURL"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$ZIP" "$BURL"
  else
    echo "ERROR: need curl or wget to download bundles." >&2
    exit 1
  fi

  unzip -oq "$ZIP" -d "$PKG_ROOT/extlibs"

  PKG_CPPFLAGS="${PKG_CPPFLAGS} -I$BDIR/include -DNDEBUG"

  GINAC_A="$BDIR/lib/libginac.a"
  CLN_A="$BDIR/lib/libcln.a"
  GMP_A="$BDIR/lib/libgmp.a"

  for f in "$GINAC_A" "$CLN_A" "$GMP_A"; do
    [ -f "$f" ] || { echo "ERROR: Missing static archive: $f" >&2; exit 1; }
  done

  PKG_LIBS="${PKG_LIBS} ${GINAC_A} ${CLN_A} ${GMP_A}"
fi

# --- C++ standard ----------------------------------------------------------
CXXSTD="CXX17"

# Dead code stripping at final link step (platform specific)
case "$UNAME_S" in
  Linux)  PKG_LIBS="$PKG_LIBS -Wl,--gc-sections" ;;
  Darwin) PKG_LIBS="$PKG_LIBS -Wl,-dead_strip" ;;
  MINGW*|MSYS*) PKG_LIBS="$PKG_LIBS -Wl,--gc-sections" ;;
esac

# Write src/Makevars (CRAN prefers PKG_* vars)
mkdir -p src
cat > src/Makevars <<EOF
CXX_STD      = $CXXSTD
PKG_CPPFLAGS = $PKG_CPPFLAGS
PKG_CFLAGS   = $PKG_CFLAGS
PKG_CXXFLAGS = $PKG_CXXFLAGS
PKG_LIBS     = $PKG_LIBS
EOF

# Keep Makevars.win for manual Windows builds from source (CRAN will ignore if OS_type: unix)
cat > src/Makevars.win <<EOF
CXX_STD      = $CXXSTD
PKG_CPPFLAGS = $PKG_CPPFLAGS
PKG_CFLAGS   = $PKG_CFLAGS
PKG_CXXFLAGS = $PKG_CXXFLAGS
PKG_LIBS     = $PKG_LIBS
EOF

echo "configure: done."
echo "  PKG_CPPFLAGS: $PKG_CPPFLAGS"
echo "  PKG_CFLAGS:   $PKG_CFLAGS"
echo "  PKG_CXXFLAGS: $PKG_CXXFLAGS"
echo "  PKG_LIBS:     $PKG_LIBS"
